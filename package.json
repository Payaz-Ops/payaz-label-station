{
  "name": "payaz-label-station",
  "version": "1.0.0",
  "private": true,
  "description": "Payaz Label Station - label printing app for the Lenovo tablet",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && npx cap sync android",
    "build:firebase": "node scripts/build-firebase.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.25.10",
    "firebase": "12.19.0",
    "qrcode-generator": "2.0.4"
